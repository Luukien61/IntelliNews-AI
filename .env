# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_PREFIX=/api/v1

# TTS Configuration
TTS_MODEL_REPO=pnnbao-ump/VieNeu-TTS-0.3B-q4-gguf
TTS_OUTPUT_DIR=outputs/tts
DEFAULT_TTS_VOICE=Doan

# Recommendation Configuration
RECOMMENDATION_MODEL_PATH=
RECOMMENDATION_CACHE_TTL=3600
RECOMMENDATION_TOP_K=10

# Redis Configuration (for recommendation caching)
REDIS_URL=redis://localhost:6379/0

# Summarization Configuration
PHOBERT_MODEL_NAME=vinai/phobert-base
VIT5_MODEL_NAME=VietAI/vit5-base-vietnews-summarization

# Embedding Model Configuration (for recommendation & clustering)
EMBEDDING_MODEL_NAME=bkai-foundation-models/vietnamese-bi-encoder

# S3 Storage Configuration
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=IrObZ9nZbaKD89Dc8vku
S3_SECRET_KEY=h8hVqXucmVje8p6QfF6TCF065LWoffHNIQsLON
S3_BUCKET_NAME=audio-files
S3_AUDIO_PREFIX=tts

# Database Configuration (PostgreSQL for AI results)
DATABASE_URL=postgresql://ai_user:ai_password@localhost:5436/intellinews_ai

# News Service Configuration
NEWS_SERVICE_URL=http://localhost:8081
NEWS_SERVICE_TIMEOUT=30

# Application
APP_NAME='IntelliNews AI Service'
APP_VERSION=0.1.0
DEBUG=true

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_GROUP_ID=ai-service-group
KAFKA_TOPIC_NEWS_FETCHED=news.fetched-events
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_EVENT_CONCURRENCY=true

# AI Processing Configuration
AI_PROCESS_PARALLEL=true
AI_PROCESS_MAX_WORKERS=4
AI_MAX_CORES=4

# Clustering Configuration
CLUSTERING_MIN_SIZE=5
CLUSTERING_MIN_SAMPLES=3
CLUSTERING_EPSILON=0.0
CLUSTERING_LOOKBACK_HOURS=24
CLUSTERING_WINDOW_HOURS=8
CLUSTERING_DECAY_LAMBDA=0.25
CLUSTERING_SCHEDULER_INTERVAL_SECONDS=30
CLUSTERING_EXPIRY_HOURS=24

# UMAP Dimension Reduction (before HDBSCAN)
CLUSTERING_UMAP_ENABLED=true
CLUSTERING_UMAP_N_COMPONENTS=50
CLUSTERING_UMAP_N_NEIGHBORS=5
CLUSTERING_UMAP_MIN_DIST=0.0
CLUSTERING_UMAP_METRIC=cosine
CLUSTERING_COHERENCE_THRESHOLD=0.75

VIT5_MIN_LENGTH=90
