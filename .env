# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_PREFIX=/api/v1

# TTS Configuration
DEFAULT_TTS_VOICE=Trang
TTS_EVENT_AUDIO_KEY=filename
CLOUDFRONT_URL=https://d213zhtaqpkk71.cloudfront.net

# Recommendation Configuration
RECOMMENDATION_MODEL_PATH=
RECOMMENDATION_CACHE_TTL=3600
RECOMMENDATION_TOP_K=10

# Redis Configuration (for recommendation caching)
REDIS_URL=redis://localhost:6379/0

# Summarization Configuration
PHOBERT_MODEL_NAME=vinai/phobert-base
VIT5_MODEL_NAME=VietAI/vit5-base-vietnews-summarization

# Embedding Model Configuration (for recommendation & clustering)
EMBEDDING_MODEL_NAME=bkai-foundation-models/vietnamese-bi-encoder

# Database Configuration (PostgreSQL for AI results)
DATABASE_URL=postgresql://postgres:your_very_secure_password@localhost:5436/intellinews_ai

# News Service Configuration
NEWS_SERVICE_URL=http://localhost:8081
NEWS_SERVICE_TIMEOUT=30

# Application
APP_NAME='IntelliNews AI Service'
APP_VERSION=0.1.0
DEBUG=true

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
KAFKA_GROUP_ID=ai-service-group
KAFKA_TOPIC_NEWS_FETCHED=news.fetched-events
KAFKA_TOPIC_TTS_COMPLETED=tts.completed-events
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_EVENT_CONCURRENCY=true

# AI Processing Configuration
AI_PROCESS_PARALLEL=true
AI_PROCESS_MAX_WORKERS=4
AI_MAX_CORES=4
VIT5_MIN_LENGTH=90
